{
  "expo": {
    "name": "Palla",
    "slug": "palla",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icons/palla-app-icon.png",
    "scheme": "palla",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.florenciasoldavini.palla",
      "config": {
        "usesNonExemptEncryption": false
      },
      "icon": "./assets/images/app-icons/palla-app-icon.png",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icons/palla-android-foreground.png",
        "backgroundImage": "./assets/images/app-icons/palla-android-background.png",
        "backgroundColor": "#062C22",
        "monochromeImage": "./assets/images/app-icons/palla-android-monochrome.png"
      },
      "package": "com.florenciasoldavini.palla",
      "edgeToEdgeEnabled": true,
      "icon": "./assets/images/app-icons/palla-app-icon.png"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "@sentry/react-native/expo",
        {
          "organization": "florencia-soldavini",
          "project": "palla"
        }
      ],
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#062C22",
          "android": {
            "image": "./assets/images/app-icons/palla-android-foreground.png",
            "imageWidth": 200
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile photo or share a photo in your Palla chats."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "chat",
          "color": "#D4FF00",
          "icon": "./assets/images/app-icons/palla-notification-icon.png"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/HankenGrotesk-Regular.ttf",
            "./assets/fonts/HankenGrotesk-Medium.ttf",
            "./assets/fonts/HankenGrotesk-SemiBold.ttf",
            "./assets/fonts/HankenGrotesk-Bold.ttf",
            "./assets/fonts/Geist-Bold.ttf",
            "./assets/fonts/Geist-Medium.ttf",
            "./assets/fonts/Geist-Regular.ttf",
            "./assets/fonts/Geist-SemiBold.ttf"
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Palla to access photos you choose to share.",
          "savePhotosPermission": "Allow Palla to save chat photos to your photo library.",
          "granularPermissions": ["photo"]
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "96d4f9c0-039c-4a09-9e0a-1626afbcf9cd"
      }
    },
    "owner": "florenciasoldavini"
  }
}
