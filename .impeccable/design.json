  "narrative": {
    "northStar": "Palla's established light interface",
    "overview": "Palla's established light interface uses a pale lavender canvas, white panels, dark ink, and lime essential actions. Hanken Grotesk carries headings and everyday interface text; proportional Geist supports compact metadata. The existing wordmark anchors the identity.\n\nThe system is spacious enough for mobile touch and compact enough for repeated session management. Shared semantic tokens and reusable components carry the same visual roles across iOS, Android, and web; screen-specific composition may adapt without changing the palette.",
    "keyCharacteristics": [
      "Light-only lavender and white surfaces.",
      "Lime actions and olive readable emphasis.",
      "Rounded controls, restrained borders, and shallow elevation.",
      "Readable, scalable text and scrollable mobile forms."
    ],
    "rules": [
      {
        "name": "Light-Only",
        "body": "Keep the interface light when the platform requests dark mode.",
        "section": "colors"
      },
      {
        "name": "Readable Accent",
        "body": "Use lime for backgrounds and highlights; use olive for accent text and focus.",
        "section": "colors"
      },
      {
        "name": "Shared Roles",
        "body": "Resolve visual choices through shared tokens and atoms rather than creating local palettes or shadows.",
        "section": "colors"
      }
