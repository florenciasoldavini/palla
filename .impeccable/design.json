  "narrative": {
    "northStar": "Palla’s Stitch-inspired club interface",
    "overview": "Palla’s Stitch-inspired club interface uses a pale lavender canvas, white panels, nested lavender blocks, dark ink, and lime essential actions. Hanken Grotesk carries headings and everyday interface text; proportional Geist supports compact metadata. The existing wordmark anchors the identity.\n\nThe system keeps the color and font character of the user’s Stitch references while correcting spacing, alignment, and mobile readability. Shared semantic tokens and reusable components carry the same visual roles across native iOS and Android; screen-specific composition may adapt without changing the palette.",
    "keyCharacteristics": [
      "Light-only lavender and white surfaces.",
      "Lime actions and olive readable emphasis.",
      "Rounded white panels with nested lavender blocks and compact roster rows.",
      "Readable, scalable text and scrollable mobile forms."
    ],
    "rules": [
      {
        "name": "Light-Only",
        "body": "Keep the interface light when the platform requests dark mode.",
        "section": "colors"
      },
      {
        "name": "Readable Accent",
        "body": "Use lime for backgrounds and highlights; use olive for accent text and focus.",
        "section": "colors"
      },
      {
        "name": "Shared Roles",
        "body": "Resolve visual choices through shared tokens and atoms rather than creating local palettes or shadows.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do reuse semantic colors and shared atoms for new screens.",
      "Do use Hanken Grotesk for headings and body text, and proportional Geist for compact metadata.",
      "Do preserve visible keyboard focus, readable errors, and controls that expand with text.",
      "Do retain scrolling, safe areas, and keyboard accommodation in mobile forms.",
      "Do use panel, inset, and row surface roles to preserve consistent tonal nesting and spacing.",
      "Do scale font sizes and line boxes together, allowing actions and rows to wrap."
    ],
    "donts": [
      "Don't introduce dark-mode inversion or a second local palette.",
      "Don't use lime as small text on white or pale surfaces.",
      "Don't treat Geist or legacy Mono-named token keys as a monospace design direction.",
      "Don't replace the approved stacked onboarding choices with a new composition."
    ]
  }
}
