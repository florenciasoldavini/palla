# Frontend / Public
EXPO_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_publishable_key"
# Public app base URL for auth redirects and shared web links.
EXPO_PUBLIC_SITE_URL="https://palla.vercel.app"

# Observability / Public
EXPO_PUBLIC_SENTRY_DSN="https://public-key@o0000000000000000.ingest.us.sentry.io/0000000000000000"

# Runtime
# Distinguishes development, preview, and production telemetry.
EXPO_PUBLIC_APP_ENV="development"

# Sentry / Optional Build-Time Source Maps
SENTRY_ORG="your-sentry-org-slug"
SENTRY_PROJECT="palla"
SENTRY_AUTH_TOKEN="sntrys_your_auth_token"

# Email / Server
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="Palla <onboarding@resend.dev>"
EMAIL_REPLY_TO="hello@example.com"
SITE_URL="https://palla.vercel.app"

# Google Places / Server
# Supabase Edge Function secret only. Never expose in Expo public variables. Restrict to Places API (New).
GOOGLE_PLACES_API_KEY="your_server_places_api_key"

# Push Notifications / Server
# Optional server-only Expo push access token when Enhanced Push Security is enabled. Set only in Supabase Edge Function secrets; never EXPO_PUBLIC.
EXPO_ACCESS_TOKEN="your_expo_push_access_token"

# Push Notifications / Native Build
# Path to Firebase google-services.json for the Android native build. Use a file environment variable in EAS; do not commit the file. Not synchronized by the generic env-sync script.
GOOGLE_SERVICES_JSON="/secure/path/google-services.json"

# Session Sharing / Public
# HTTPS origin for public session links and native app-link association. Separate from local auth redirects.
EXPO_PUBLIC_SESSION_SHARE_URL="https://palla-pink.vercel.app"

# Session Sharing / Server
# Legacy public anon JWT for invoking the existing JWT-verified session-cover function. Never use a service-role key.
SESSION_SHARE_SUPABASE_ANON_KEY="your_legacy_anon_jwt"

# Session Sharing / Signing
# Apple Developer Team ID for associated domains and the public AASA response.
APPLE_TEAM_ID="YOURTEAMID1"
# Comma-separated SHA-256 release/Play signing certificate fingerprints. Do not publish debug keys on the production domain.
ANDROID_APP_LINK_FINGERPRINTS="YOUR_RELEASE_SHA256_FINGERPRINTS"

# Google Maps / Native Build
# Native client key, restricted to Maps SDK for IOS and Palla bundle identifier. Separate from the server Places key. Requires rebuilding the native client.
GOOGLE_MAPS_IOS_API_KEY="your_ios_maps_key"
# Native client key, restricted to Maps SDK for ANDROID and Palla package and signing fingerprint. Separate from the server Places key. Requires rebuilding the native client.
GOOGLE_MAPS_ANDROID_API_KEY="your_android_maps_key"
